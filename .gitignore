# Kaggle official data: keep locally, do not redistribute through GitHub.
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep

# Derived large artifacts
data/processed/*
data/samples/*
!data/samples/README.md
!data/samples/.gitkeep
models/*
submissions/*
!submissions/README.md
!submissions/.gitkeep

# Local notebooks and caches
*.ipynb
__pycache__/
.ipynb_checkpoints/
.pytest_cache/

# Secrets
.env
.env.*
kaggle.json

# OS/editor
.DS_Store
Thumbs.db
.vscode/
.idea/
